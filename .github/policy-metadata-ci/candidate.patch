+                        if global { "" } else { "default" },
+                        version,
+                        &policy.encode_to_vec(),
+                        "stale-stored-hash",
+                    )
+                    .await
+                    .unwrap();
+            }
+            state
+                .store
+                .update_policy_status(policy_id, 1, "loaded", None, Some(1_000_000))
+                .await
+                .unwrap();
