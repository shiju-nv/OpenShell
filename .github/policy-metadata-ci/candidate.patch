+#[tokio::test]
+async fn policy_revision_metadata_rpc_modes_cover_both_scopes_and_views() {
+    let ts = run_server().await;
+    let mut expected_requests = Vec::new();
+    for global in [false, true] {
+        for (view, metadata_only) in [
+            (run::PolicyGetView::Metadata, true),
+            (run::PolicyGetView::Base, false),
+            (run::PolicyGetView::Full, false),
+        ] {
+            let (stdout, stderr) = policy_revision_output(&ts, global, 3, view, "json")
+                .await
+                .expect("explicit revision should be available");
+            assert!(stderr.is_empty());
+            let json: serde_json::Value = serde_json::from_slice(&stdout).unwrap();
+            assert_eq!(json["version"], 3);
+            assert_eq!(json.get("policy").is_none(), metadata_only);
+            expected_requests.push((global, 3, metadata_only));
+        }
+    }
+
+    // Reading the current global policy still requires strict materialization.
+    policy_revision_output(&ts, true, 0, run::PolicyGetView::Metadata, "json")
+        .await
+        .expect("current global policy should remain available");
+    expected_requests.push((true, 0, false));
+
+    // Current sandbox policy reads retain the effective-config RPC path.
+    let (stdout, stderr) =
+        policy_revision_output(&ts, false, 0, run::PolicyGetView::Metadata, "json")
+            .await
+            .expect("effective sandbox policy should remain available");
+    assert!(stderr.is_empty());
+    let json: serde_json::Value = serde_json::from_slice(&stdout).unwrap();
+    assert_eq!(json["version"], 9);
+    assert_eq!(json["status"], "effective");
+
+    let requests = ts.openshell.state.policy_status_requests.lock().await;
+    let actual: Vec<_> = requests
+        .iter()
+        .map(|request| (request.global, request.version, request.metadata_only))
+        .collect();
+    assert_eq!(actual, expected_requests);
+}
