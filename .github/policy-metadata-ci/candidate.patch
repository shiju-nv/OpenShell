+#[tokio::test]
+async fn policy_revision_metadata_payload_views_propagate_strict_errors() {
+    let ts = run_server().await;
+    *ts.openshell.state.policy_load_error.lock().await = Some("invalid stored policy".into());
+    for global in [false, true] {
+        for view in [run::PolicyGetView::Base, run::PolicyGetView::Full] {
+            let error = policy_revision_output(&ts, global, 3, view, "json")
+                .await
+                .expect_err("payload requests must retain materialization failures");
+            assert!(
+                error
+                    .to_string()
+                    .contains("stored policy cannot be materialized")
+            );
+        }
+    }
+    let requests = ts.openshell.state.policy_status_requests.lock().await;
+    assert_eq!(
+        requests.len(),
+        4,
+        "strict failures must not trigger a metadata retry"
+    );
+    assert!(requests.iter().all(|request| !request.metadata_only));
+}
