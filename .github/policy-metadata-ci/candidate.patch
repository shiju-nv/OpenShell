+        prost::encoding::bytes::encode(2, &legacy_rule, &mut rule_entry);
+        let mut malformed_legacy_payload = malformed_legacy.encode_to_vec();
+        prost::encoding::bytes::encode(5, &rule_entry, &mut malformed_legacy_payload);
+        let current_policy = ProtoSandboxPolicy::decode(malformed_legacy_payload.as_slice())
+            .expect("the current policy protobuf must remain readable");
+        validate_and_canonicalize_policy(current_policy)
+            .expect("the current policy remains valid without the reserved field");
+        decode_stored_policy(&malformed_legacy_payload)
+            .expect_err("the stored-policy legacy decoder must reject the wire type");
+
+        for (version, payload) in [
+            (1, valid.encode_to_vec()),
+            (2, legacy_non_mcp_policy_with_mcp_options().encode_to_vec()),
+            (3, malformed_legacy_payload),
+        ] {
+            state
+                .store
+                .put_policy_revision(
+                    &format!("{sandbox_id}-{version}"),
+                    sandbox_id,
+                    "default",
+                    version,
+                    &payload,
+                    "untrusted-stored-hash",
+                )
+                .await
+                .unwrap();
+        }
+
+        for (version, expected_code) in [(2, Code::FailedPrecondition), (3, Code::Internal)] {
+            // A stored loaded status must not make an invalid payload exportable.
+            state
+                .store
+                .update_policy_status(
+                    sandbox_id,
+                    version,
+                    "loaded",
+                    Some("retained load diagnostic"),
+                    Some(1_000_000),
+                )
+                .await
+                .unwrap();
+            let stored = state
+                .store
+                .get_policy_by_version(sandbox_id, version)
+                .await
+                .unwrap()
+                .unwrap();
+            let request = GetSandboxPolicyStatusRequest {
+                name: sandbox_id.to_string(),
+                version: u32::try_from(version).unwrap(),
+                workspace_scope: Some(openshell_core::proto::workspace_selector("default")),
+                ..Default::default()
+            };
+            let error =
+                handle_get_sandbox_policy_status(&state, with_user(Request::new(request.clone())))
+                    .await
+                    .expect_err("full-policy reads must reject invalid stored payloads");
+            assert_eq!(error.code(), expected_code);
+
+            let response = handle_get_sandbox_policy_status(
+                &state,
+                with_user(Request::new(GetSandboxPolicyStatusRequest {
+                    metadata_only: true,
+                    ..request
+                })),
+            )
+            .await
+            .expect("invalid revisions must remain inspectable as metadata")
+            .into_inner();
+            assert_eq!(response.active_version, 1);
+            let revision = response.revision.unwrap();
+            assert_eq!(revision.version, u32::try_from(version).unwrap());
+            assert_eq!(revision.status, PolicyStatus::Failed as i32);
+            assert!(revision.policy.is_none());
+            assert!(revision.policy_hash.is_empty());
+            assert!(
+                revision
+                    .load_error
+                    .starts_with("retained load diagnostic; ")
+            );
+            assert!(revision.load_error.contains(error.message()));
+            assert_eq!(
+                revision.created_time,
+                openshell_core::time::timestamp_from_millis(stored.created_at_ms).ok()
+            );
+            assert_eq!(
+                revision.loaded_time,
+                openshell_core::time::timestamp_from_millis(1_000_000).ok()
+            );
+            assert_eq!(revision.provenance, stored.provenance);
+            let unchanged = state
+                .store
+                .get_policy_by_version(sandbox_id, version)
+                .await
+                .unwrap()
+                .unwrap();
+            assert_eq!(unchanged.status, "loaded");
+            assert_eq!(unchanged.policy_hash, "untrusted-stored-hash");
+            assert_eq!(unchanged.policy_payload, stored.policy_payload);
+        }
